@page "/dashboard"
@model _bootstrap_scaffold.Pages.Dashboard.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = T("Pulpit");
}

@using _bootstrap_scaffold.Dashboard
@using _bootstrap_scaffold.Strategies
@using _bootstrap_scaffold.Watchlist

<section class="watchlist-page" aria-labelledby="dashboard-title">
    <header class="watchlist-page__header">
        <div class="watchlist-page__heading">
            <h1 id="dashboard-title">@Model.Greeting</h1>
            <p>@T("Przeglądaj dane rynkowe, poznaj profile strategii i zbuduj wirtualny portfel.")</p>
        </div>
    </header>

    <section class="watchlist-card watchlist-card--padded dashboard-welcome" aria-labelledby="dashboard-welcome-title">
        <div>
            <h2 id="dashboard-welcome-title">@T("Witaj w Argus")</h2>
            <p class="account-note">@T("Argus pomaga uczyć się inwestowania na podstawie publicznie dostępnych danych: zgłoszeń instytucji, osób z wewnątrz spółek i innych źródeł. Możesz zbudować wirtualny portfel i przeglądać dane historyczne — wszystko bez prawdziwych pieniędzy.")</p>
        </div>
        <a class="button" asp-page="/Strategies/Index">@T("Poznaj profile strategii")</a>
    </section>

    <section class="watchlist-card" aria-labelledby="dashboard-watchlist-title">
        <header class="watchlist-card__header watchlist-card__header--inline">
            <h2 id="dashboard-watchlist-title">@T("Twoja lista obserwowanych")</h2>
            <a asp-page="/Watchlist/Index">@T("Zobacz wszystkie")</a>
        </header>
        @if (Model.WatchlistFailed)
        {
            <div class="status-card status-card--error" role="status">
                <p>@T(DashboardPresenter.WatchlistFailedMessage)</p>
            </div>
        }
        else if (Model.WatchlistEmpty)
        {
            <div class="watchlist-empty status-card" role="status">
                <h3>@T("Lista obserwowanych jest pusta")</h3>
                <p>@T("Zapisz aktywa na stronie analizy, aby zobaczyć tutaj ich ceny i zmiany.")</p>
                <a class="button" asp-page="/Analysis/Index">@T("Przejdź do analizy")</a>
            </div>
        }
        else
        {
            <div class="watchlist-table-scroll">
                <table class="watchlist-table">
                    <thead>
                        <tr>
                            <th scope="col">Symbol</th>
                            <th scope="col">@T("Nazwa")</th>
                            <th scope="col" class="watchlist-table__number">@T("Ostatnia cena")</th>
                            <th scope="col" class="watchlist-table__number">@T("Zmiana 24h")</th>
                            <th scope="col" class="watchlist-table__number">@T("7 dni")</th>
                            <th scope="col" class="watchlist-table__number">@T("30 dni")</th>
                            <th scope="col" title="@T(WatchlistTablePresenter.TrendHint)">@T(WatchlistTablePresenter.TrendHeader)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.WatchlistRows)
                        {
                            <tr class="@(row.IsAvailable ? null : "watchlist-table__row--unavailable")" data-dashboard-row="@row.AssetId">
                                <th scope="row" class="watchlist-table__symbol">
                                    <partial name="_AssetGlyph" model="row.AssetId" />
                                    <span>@row.AssetId</span>
                                    @if (!row.IsAvailable)
                                    {
                                        <span class="watchlist-row__status">@T("Niedostępne")</span>
                                    }
                                </th>
                                <td>@row.Name</td>
                                <td class="watchlist-table__number">@row.PriceText</td>
                                <td class="watchlist-table__number @WatchlistTablePresenter.ToneClass(row.Change24Hours.Tone)">@row.Change24Hours.Text</td>
                                <td class="watchlist-table__number @WatchlistTablePresenter.ToneClass(row.Change7Days.Tone)">@row.Change7Days.Text</td>
                                <td class="watchlist-table__number @WatchlistTablePresenter.ToneClass(row.Change30Days.Tone)">@row.Change30Days.Text</td>
                                <td>
                                    @if (row.Sparkline is { } rowSparkline)
                                    {
                                        <span class="watchlist-sparkline @WatchlistTablePresenter.ToneClass(rowSparkline.Tone)">
                                            <partial name="_Sparkline" model="rowSparkline" view-data='new ViewDataDictionary(ViewData) { ["SparklineLabel"] = T("Trend ceny: {0}", row.Name) }' />
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="watchlist-tone--unavailable">@T(WatchlistTablePresenter.MissingDataText)</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.WatchlistHasMore)
            {
                <footer class="watchlist-card__footer">
                    <a asp-page="/Watchlist/Index">@T("Zobacz wszystkie")</a>
                </footer>
            }
        }
    </section>

    <section class="watchlist-card watchlist-card--padded" aria-labelledby="dashboard-market-title">
        <header class="watchlist-card__header">
            <h2 id="dashboard-market-title">@T("Przegląd rynku")</h2>
            <p>@T("Zmiana 24h")</p>
        </header>
        @if (Model.MarketUnavailable)
        {
            <div class="status-card status-card--error" role="status">
                <p>@T(DashboardPresenter.UnavailableMessage)</p>
            </div>
        }
        <ul class="dashboard-tiles">
            @foreach (var tile in Model.Tiles)
            {
                var tone = WatchlistTablePresenter.ToneClass(tile.Change.Tone);
                <li class="dashboard-tile" data-market-tile="@tile.AssetId">
                    <p class="dashboard-tile__name">
                        <partial name="_AssetGlyph" model="tile.AssetId" />
                        <span>@tile.AssetId <small>@tile.Name</small></span>
                    </p>
                    <p class="dashboard-tile__price">@tile.PriceText</p>
                    <p class="dashboard-tile__change @tone">@tile.Change.Text</p>
                    @if (tile.Sparkline is { } sparkline)
                    {
                        <span class="watchlist-sparkline @WatchlistTablePresenter.ToneClass(sparkline.Tone)">
                            <partial name="_Sparkline" model="sparkline" view-data='new ViewDataDictionary(ViewData) { ["SparklineLabel"] = T("Trend ceny: {0}", tile.Name) }' />
                        </span>
                    }
                </li>
            }
        </ul>
    </section>

    <div class="account-grid">
        <section class="watchlist-card watchlist-card--padded" aria-labelledby="dashboard-portfolio-title">
            <header class="watchlist-card__header watchlist-card__header--inline">
                <h2 id="dashboard-portfolio-title">@T("Twój wirtualny portfel")</h2>
                <span class="watchlist-badge">@T(StrategyProfileCatalog.SampleBadge)</span>
            </header>
            <h3 class="dashboard-portfolio__title">@T("Zbuduj pierwszy model portfela")</h3>
            <p class="account-note">@T("Połącz profile strategii, ustaw alokację i zobacz, jak taki portfel zachowywałby się historycznie. Kreator portfela jest niedostępny w tej wersji.")</p>
            <div class="account-actions">
                <button class="button" type="button" disabled>@T("Utwórz portfel")</button>
            </div>
        </section>

        <section class="watchlist-card watchlist-card--padded" aria-labelledby="dashboard-insights-title">
            <header class="watchlist-card__header">
                <h2 id="dashboard-insights-title">@T("Najważniejsze wnioski")</h2>
            </header>
            @if (Model.Insights.Count == 0)
            {
                <p class="watchlist-placeholder">@(Model.WatchlistEmpty
                    ? T("Wnioski pojawią się po zapisaniu aktywów na liście obserwowanych.")
                    : T("Brak danych do opisania zmian obserwowanych aktywów."))</p>
            }
            else
            {
                <ul class="account-list dashboard-insights">
                    @foreach (var insight in Model.Insights)
                    {
                        <li data-dashboard-insight="@insight.AssetId">
                            <partial name="_AssetGlyph" model="insight.AssetId" />
                            <span class="dashboard-insights__text">
                                <strong><a asp-page="/Analysis/Index">@insight.AssetId · @insight.Name</a></strong>
                                <small>@T(insight.Text)</small>
                            </span>
                            @if (insight.TrendLabel is { } trendLabel)
                            {
                                <small>@T(trendLabel)</small>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    </div>

    <section class="watchlist-card watchlist-card--padded" aria-labelledby="dashboard-strategies-title">
        <header class="watchlist-card__header watchlist-card__header--inline">
            <h2 id="dashboard-strategies-title">@T("Poznaj profile strategii")</h2>
            <span class="watchlist-badge">@T(StrategyProfileCatalog.SampleBadge)</span>
        </header>
        <ul class="strategy-grid">
            @foreach (var profile in StrategyProfileCatalog.DashboardProfiles)
            {
                <li class="strategy-card" data-strategy-profile="@profile.Id">
                    <span class="strategy-icon @StrategyProfileCatalog.AccentClass(profile.AccentIndex)" aria-hidden="true">@profile.Monogram</span>
                    <h3><a class="strategy-card__link" asp-page="/Strategies/Index">@T(profile.Name)</a></h3>
                    <p>@T(profile.Description)</p>
                    <p class="strategy-card__range">@T(profile.StockRange)</p>
                    @if (profile.IsExample)
                    {
                        <span class="watchlist-badge">@T("Przykład")</span>
                    }
                </li>
            }
        </ul>
    </section>

    <section class="status-card" aria-labelledby="dashboard-disclaimer-title">
        <h2 id="dashboard-disclaimer-title">@T("Narzędzie edukacyjne")</h2>
        <p>@T("Argus służy wyłącznie do nauki i badania danych. Nie dokonuje prawdziwych transakcji i nie stanowi porady inwestycyjnej.")</p>
    </section>

    <p class="watchlist-page__boundary">
        @T("Wyniki mają charakter edukacyjny i nie stanowią porady inwestycyjnej.")
    </p>
</section>
