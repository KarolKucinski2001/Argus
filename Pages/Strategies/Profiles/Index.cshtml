@page "/strategies/profiles"
@model _bootstrap_scaffold.Pages.Strategies.Profiles.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = T("Profile publiczne");
}

@using _bootstrap_scaffold.Strategies

<section class="watchlist-page" aria-labelledby="profiles-title">
    <header class="watchlist-page__header">
        <div class="watchlist-page__heading">
            <h1 id="profiles-title">@T("Profile publiczne")</h1>
            <p>@T("Poznaj skład znanych portfeli publicznych i skopiuj wybrany do własnego portfela symulowanego.")</p>
        </div>
        <a class="button button--secondary" asp-page="/Strategies/Portfolios/Index">@T("Moje portfele symulowane")</a>
    </header>

    <section class="watchlist-card watchlist-card--padded" aria-labelledby="profiles-list-title">
        <header class="watchlist-card__header watchlist-card__header--inline">
            <h2 id="profiles-list-title">@T("Wybrane profile")</h2>
            <span class="watchlist-badge">@T(CuratedProfileCatalog.ApproximateBadge)</span>
        </header>
        <p class="account-note" role="note">@T(CuratedProfileCatalog.Disclaimer)</p>
        <p class="account-note" role="note">@T(CuratedProfileCatalog.ProvenanceNote) @T(CuratedProfileCatalog.ApproximateExplanation)</p>
        <ul class="strategy-grid">
            @foreach (var card in Model.Cards)
            {
                <li class="strategy-card" data-strategy-profile="@card.Id">
                    <span class="strategy-icon @StrategyProfileCatalog.AccentClass(card.AccentIndex)" aria-hidden="true">@card.Monogram</span>
                    <h3>@card.Name</h3>
                    <p>@card.Description</p>
                    <p class="strategy-card__range">@card.HoldingsCount</p>
                    <p>@card.AsOfText</p>
                    <p>@card.SourceLabel</p>
                    <a class="strategy-card__link" asp-page="/Strategies/Profiles/Detail" asp-route-id="@card.Id">@T("Zobacz skład")</a>
                </li>
            }
        </ul>
        <p class="strategy-quality__note" role="note">@T(CuratedProfileCatalog.DataNote)</p>
    </section>

    <p class="watchlist-page__boundary">
        @T("Wyniki mają charakter edukacyjny i nie stanowią porady inwestycyjnej.")
    </p>
</section>
