@page "/strategies/profiles/{id}"
@model _bootstrap_scaffold.Pages.Strategies.Profiles.DetailModel
@{
    Layout = "_Layout";
    var profile = Model.Profile!;
    ViewData["Title"] = profile.Name;
}

@using _bootstrap_scaffold.Strategies

<section class="watchlist-page" aria-labelledby="profile-title">
    <header class="watchlist-page__header">
        <div class="watchlist-page__heading">
            <h1 id="profile-title">@profile.Name</h1>
            <p>@profile.Description</p>
        </div>
        <a class="button button--secondary" asp-page="/Strategies/Profiles/Index">@T("Wszystkie profile")</a>
    </header>

    @if (Model.Message is not null)
    {
        <div class="status-card status-card--error" role="alert">
            <p>@Model.Message</p>
        </div>
    }

    <section class="watchlist-card watchlist-card--padded" aria-labelledby="profile-meta-title">
        <header class="watchlist-card__header watchlist-card__header--inline">
            <h2 id="profile-meta-title">@T("Dane profilu")</h2>
            <span class="watchlist-badge">@T(CuratedProfileCatalog.ApproximateBadge)</span>
        </header>
        <dl class="account-stats">
            <div>
                <dt>@T("Aktualność danych")</dt>
                <dd>@profile.AsOfText</dd>
            </div>
            <div>
                <dt>@T("Źródło")</dt>
                <dd>@profile.SourceLabel</dd>
            </div>
        </dl>
        <p class="strategy-quality__note" role="note">@T(CuratedProfileCatalog.Disclaimer) @T(CuratedProfileCatalog.DataNote)</p>
        <p class="account-note" role="note">@T(CuratedProfileCatalog.ProvenanceNote) @T(CuratedProfileCatalog.ApproximateExplanation)</p>
        <form method="post" asp-page-handler="Copy" asp-route-id="@profile.Id" class="account-actions">
            <button class="button" type="submit">@T("Skopiuj do portfela symulowanego")</button>
        </form>
    </section>

    <section class="watchlist-card" aria-labelledby="profile-holdings-title">
        <header class="watchlist-card__header watchlist-card__header--inline">
            <h2 id="profile-holdings-title">@T("Pozycje profilu")</h2>
            <span class="watchlist-badge">@T(CuratedProfileCatalog.ApproximateBadge)</span>
        </header>
        <partial name="_ProfileHoldingsTable" model="profile.Holdings" />
    </section>

    <div class="account-grid">
        <section class="watchlist-card watchlist-card--padded" aria-labelledby="profile-sector-title">
            <header class="watchlist-card__header">
                <h2 id="profile-sector-title">@T("Udział sektorów")</h2>
            </header>
            <partial name="_ProfileShares" model="profile.SectorShares" />
        </section>
        <section class="watchlist-card watchlist-card--padded" aria-labelledby="profile-class-title">
            <header class="watchlist-card__header">
                <h2 id="profile-class-title">@T("Udział klas aktywów")</h2>
            </header>
            <partial name="_ProfileShares" model="profile.AssetClassShares" />
        </section>
    </div>

    <section class="watchlist-card watchlist-card--padded" aria-labelledby="profile-factors-title">
        <header class="watchlist-card__header">
            <h2 id="profile-factors-title">@T("Czynniki opisujące skład")</h2>
        </header>
        <ul class="account-note">
            @foreach (var factor in profile.Factors)
            {
                <li>@factor</li>
            }
        </ul>
    </section>

    <p class="watchlist-page__boundary">
        @T("Wyniki mają charakter edukacyjny i nie stanowią porady inwestycyjnej.") @T(CuratedProfileCatalog.Disclaimer)
    </p>
</section>
