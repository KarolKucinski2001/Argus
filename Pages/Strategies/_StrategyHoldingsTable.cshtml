@using _bootstrap_scaffold.Strategies
@model IReadOnlyList<StrategyHoldingView>

<div class="watchlist-table-scroll">
    <table class="watchlist-table strategy-table">
        <thead>
            <tr>
                <th scope="col">@T("Aktywo")</th>
                <th scope="col">@T("Profil")</th>
                <th scope="col" class="watchlist-table__number">@T("Waga")</th>
                <th scope="col" class="watchlist-table__number">@T("Wartość pozycji")</th>
                <th scope="col">@T("Ostatnia transakcja")</th>
                <th scope="col">@T("Opublikowano")</th>
                <th scope="col">@T("Źródło")</th>
                <th scope="col">@T("Kompletność")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var holding in Model)
            {
                <tr>
                    <th scope="row" class="watchlist-table__symbol">
                        <partial name="_AssetGlyph" model="holding.AssetId" />
                        <span>@holding.AssetId <small>@holding.Name</small></span>
                    </th>
                    <td>@T(holding.Profile)</td>
                    <td class="watchlist-table__number">@T(holding.Weight)</td>
                    <td class="watchlist-table__number">@T(holding.PositionValue)</td>
                    <td>@holding.LastTransaction</td>
                    <td>@holding.Published</td>
                    <td>@holding.Source</td>
                    <td>
                        <span class="strategy-meter">
                            <meter class="strategy-meter__bar" min="0" max="100" value="@holding.Completeness" aria-label="@T("Kompletność danych: {0}", holding.AssetId)">@holding.Completeness%</meter>
                            <span>@holding.Completeness%</span>
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
